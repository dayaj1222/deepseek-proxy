# DeepSeek OpenAI Proxy — template for .env
# Copy to .env and fill in real values. .env is git-ignored.

# --- DeepSeek credentials (prefer token over email+password) ---
# A single token account:
DEEPSEEK_TOKEN=
# Or indexed email/password accounts (0,1,2,...), used for load balancing:
DEEPSEEK_EMAIL_0=
DEEPSEEK_PASSWORD_0=
# DEEPSEEK_EMAIL_1=
# DEEPSEEK_PASSWORD_1=

# --- Persistence backend ---
# "sqlite" (default, local) or "mongo" (deployment)
STORAGE_BACKEND=sqlite
# Required when STORAGE_BACKEND=mongo. Contains a password — keep it here, not
# in config.toml. Percent-encode special characters in the password.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
MONGODB_DB=deepseek_proxy
