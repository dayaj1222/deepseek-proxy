# DeepSeek OpenAI Proxy — template for .env
# Copy to .env and fill in real values. .env is git-ignored.

# --- DeepSeek credentials (prefer token over email+password) ---
# A single token account:
DEEPSEEK_TOKEN=
# Or indexed email/password accounts (0,1,2,...), used for load balancing:
DEEPSEEK_EMAIL_0=
DEEPSEEK_PASSWORD_0=
# DEEPSEEK_EMAIL_1=
# DEEPSEEK_PASSWORD_1=

# --- API key auth (off locally by default) ---
# Set AUTH_ENABLED=true and provide ADMIN_USER/ADMIN_PASS to require keys on
# /v1/* and expose the /admin management UI. Leave false for local development.
AUTH_ENABLED=false
ADMIN_USER=
ADMIN_PASS=

# --- Admin log viewer (optional) ---
# Size of the in-memory log ring buffer backing the Logs tab at /admin.
# Starts empty on restart, and records older than this are dropped from
# memory. Set 0 to disable the buffer and the tab's data.
ADMIN_LOG_BUFFER=50

# --- Persistence backend ---
# "sqlite" (default, local) or "mongo" (deployment)
STORAGE_BACKEND=sqlite
# Required when STORAGE_BACKEND=mongo. Contains a password — keep it here, not
# in config.toml. Percent-encode special characters in the password.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
MONGODB_DB=deepseek_proxy
